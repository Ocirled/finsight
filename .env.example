# Database (Neon PostgreSQL - https://neon.tech)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here-run-openssl-rand-base64-32"

# Groq AI - FREE (https://console.groq.com)
GROQ_API_KEY="your-groq-api-key"

# Email — Resend (https://resend.com)
RESEND_API_KEY="re_xxxxxxxx"
# Pakai domain terverifikasi di Resend, mis. "FinSight <noreply@domainmu.com>".
# Untuk testing tanpa domain: "FinSight <onboarding@resend.dev>" (hanya kirim ke email akun Resend-mu)
EMAIL_FROM="FinSight <onboarding@resend.dev>"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="FinSight"
